EMAIL=your_locket_email@example.com
PASSWORD=your_locket_password
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional, recommended for public deploys.
# Create the table with supabase_schema.sql, then set these values on Vercel.
